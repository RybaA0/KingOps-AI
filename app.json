{
  "expo": {
    "name": "KingAi",
    "slug": "kingai-mobile",
    "scheme": "kingai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "eu.kingops.kingai",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Mikrofon służy do dyktowania wiadomości głosem.",
        "NSCameraUsageDescription": "Aparat służy do robienia zdjęć dołączanych do rozmowy.",
        "NSPhotoLibraryUsageDescription": "Dostęp do galerii pozwala dołączać zdjęcia do rozmowy."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0b0f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-audio",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0b0b0f"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/splash-icon.png",
          "color": "#8b5cf6"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d533a67b-eec4-4e02-900d-96f38dbb4474"
      }
    },
    "owner": "kacperek"
  }
}
